# Copy to .env and fill in. .env is git-ignored; never commit a real key.

# With OPENROUTER_API_KEY set, the live model is used. With no key, the app replays saved answers.
# Set this only to force one: openrouter | replay
# LLM_PROVIDER=

# Model name as the provider knows it. Chosen in M3.
LLM_MODEL=

# Leave empty to run on saved answers
OPENROUTER_API_KEY=
