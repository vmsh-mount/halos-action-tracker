# Copy to .env and fill in. .env is git-ignored; never commit a real key.
#
# The app talks to any chat-completions API. These three settings say which one. With LLM_API_KEY empty the
# app replays saved answers and needs no network.

# Where the API lives. OpenRouter shown; any compatible endpoint works.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model name as that API knows it.
LLM_MODEL=openai/gpt-5-mini

# Your key. Leave empty to run on saved answers. To reuse a key already in your shell without copying it
# here, reference it: LLM_API_KEY=${OPENROUTER_API_KEY}
LLM_API_KEY=

# Set only to force one: api | replay
# LLM_PROVIDER=

# Sent only when set. Many current models do not accept a temperature at all.
# LLM_TEMPERATURE=0
